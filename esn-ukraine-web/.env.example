# =============================================================================
# ESN Ukraine website — environment variables template
# =============================================================================
# 1. Copy this file:      cp .env.example .env.local
# 2. Fill in the values.  Ask the maintainer or copy them from the Vercel project.
# 3. Never commit real values. All `.env*` files except this template are
#    ignored by Git.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the JavaScript sent to
# browsers and are therefore PUBLIC. Never put a secret in a NEXT_PUBLIC_ variable.
#
# Full reference: ../docs/reference/environment-variables.md
# =============================================================================


# --- Sanity CMS: project (required) ------------------------------------------
# Found in sanity.io/manage → your project. The app fails to start without them.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional. Sanity API version as a date (YYYY-MM-DD). Defaults to 2026-01-24.
NEXT_PUBLIC_SANITY_API_VERSION=


# --- Sanity CMS: server-side secrets -----------------------------------------
# Read token (Viewer role) from sanity.io/manage → API → Tokens.
# Needed only for Draft Mode (previewing unpublished content).
SANITY_API_READ_TOKEN=

# Shared secret sent by the Sanity webhook to /api/revalidate.
# Required in Production for on-demand content updates. Use a long random string.
SANITY_REVALIDATE_SECRET=


# --- Newsletter: Resend ------------------------------------------------------
# Required for the newsletter form. Without them the API answers 503.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=


# --- Newsletter: rate limiting (Upstash Redis REST API) ----------------------
# Required in Production (the newsletter API answers 503 without them).
# Optional for local development and Vercel Preview (rate limiting is skipped).
KV_REST_API_URL=
KV_REST_API_TOKEN=


# --- Analytics: PostHog (optional) -------------------------------------------
# PostHog project API key (EU Cloud). Leave empty to disable PostHog.
NEXT_PUBLIC_POSTHOG_KEY=


# --- Set automatically by Vercel — do not define manually --------------------
# VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL
